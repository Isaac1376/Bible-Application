# Optional: ESV API token for live scripture lookup
VITE_ESV_API_TOKEN=your-esv-api-token

# Admin login credentials (required for /admin access)
# Note: client-side env vars are visible in the built bundle.
# For production, use a backend with server-side authentication.
VITE_ADMIN_EMAIL=your-admin-email
VITE_ADMIN_PASSWORD=your-admin-password
